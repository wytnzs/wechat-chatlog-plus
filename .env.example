# Chatlog core must already be running locally.
CHATLOG_CORE_URL=http://127.0.0.1:5030
CHATLOG_PLUS_HOST=127.0.0.1
CHATLOG_PLUS_PORT=5031

# Optional storage location. Do not put this directory in Git.
# CHATLOG_PLUS_STATE_DIR=D:\ChatlogPlus
# CHATLOG_PLUS_MODEL_DIR=D:\ChatlogPlus\models
# CHATLOG_PLUS_CACHE_DB=D:\ChatlogPlus\transcripts.sqlite3
# CHATLOG_PLUS_LOG_PATH=D:\ChatlogPlus\server.log

CHATLOG_PLUS_MODEL=turbo
CHATLOG_PLUS_LANGUAGE=zh
CHATLOG_PLUS_DEVICE=auto
# CHATLOG_PLUS_COMPUTE_TYPE=int8
# CHATLOG_PLUS_INITIAL_PROMPT=以下是微信聊天语音，可能包含中文和英语。
