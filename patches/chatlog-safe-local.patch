+func loadInternalDBMasks(exePath, fullVersion string) [][32]byte {
+	baseDir := filepath.Dir(exePath)
+	paths := []string{
+		filepath.Join(baseDir, fullVersion, "Weixin.dll"),
+		filepath.Join(baseDir, "Weixin.dll"),
